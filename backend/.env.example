# LLM: choose one provider and its model. LLM_API_KEY is empty for Ollama.
LLM_PROVIDER=ollama
LLM_API_KEY=
LLM_MODEL=qwen3:1.7b
# Required only for Ollama; use host.docker.internal when the backend runs in Docker.
OLLAMA_HOST=http://host.docker.internal:11434
POSTGRES_USER=
POSTGRES_PASS=
POSTGRES_DB=
DATABASE_URL=postgresql+asyncpg://cover_letter_user:change-me@postgres:5432/cover_letter_db
CELERY_BROKER_URL=amqp://guest:guest@rabbitmq:5672//
REDIS_URL=redis://:change-me@redis:6379/0
REDIS_PASSWORD=change-me
SECRET_KEY=

SECRET_KEY=
